    "en": {
      "text-1": "LongDe Yizhi",
      "text-2": "Products",
      "text-3": "Custom Manufacturing",
      "text-4": "Capability",
      "text-5": "Why LDYZ",
      "text-6": "Request a Quote",
      "text-7": "/",
      "text-8": "CUSTOM RF WELDED PRODUCTS",
      "text-9": "Bring us your drawing, sample or product concept.",
      "text-10": "LDYZ supports custom EVA, PVC and TPU product development with RF welding technology, from material selection through final packaging.",
      "text-11": "Request a Quote",
      "text-12": "RF WELDING CAPABILITY",
      "text-13": "Built for custom product development",
      "text-14": "Materials",
      "text-15": "EVA, PVC and TPU material options can be reviewed against product use and construction needs.",
      "text-16": "Manufacturing steps",
      "text-17": "Printing, cutting, RF welding, assembly, inspection and packaging are considered as one manufacturing flow.",
      "text-18": "Custom projects",
      "text-19": "Suitable for product formats not fully covered by our standard categories.",
      "text-20": "HOW WE WORK",
      "text-21": "From brief to production",
      "text-22": "Share a drawing, physical sample or product concept. We review the material, construction and process requirements with you before confirming a suitable approach.",
      "text-23": "01 — Define",
      "text-24": "Share a drawing, physical sample or product concept with your requirements.",
      "text-25": "02 — Develop",
      "text-26": "Align material, construction, printing and sample development for the project.",
      "text-27": "03 — Produce",
      "text-28": "Move approved requirements into production, inspection and final packaging.",
      "text-29": "Project scope and manufacturing suitability are confirmed against each customer brief.",
      "text-30": "CUSTOM MANUFACTURING",
      "text-31": "Your product. Our manufacturing capability.",
      "text-32": "EVA · PVC · TPU",
      "text-33": "RF welding",
      "text-34": "Sample development",
      "text-35": "Inspection & packaging",
      "text-36": "Start your custom project",
      "text-37": "SOCIAL RESPONSIBILITY",
      "text-38": "BSCI social audit",
      "text-39": "Our factory has undergone an amfori BSCI social audit. Audit documentation is available to qualified buyers on request.",
      "meta_title": "Custom RF Welded Products | LongDe Yizhi",
      "meta_desc": "Custom RF welded EVA, PVC and TPU products developed from drawings, samples and product concepts."
    },
