    "en": {
      "text-1": "LongDe Yizhi",
      "text-2": "Products",
      "text-3": "Custom Manufacturing",
      "text-4": "Capability",
      "text-5": "Why LDYZ",
      "text-6": "Request a Quote",
      "text-7": "/",
      "text-8": "BAGS & POUCHES",
      "text-9": "Custom bags and pouches for your product brief.",
      "text-10": "We support the development of zipper pouches, storage bags and packaging solutions based on your drawing, sample or product concept.",
      "text-11": "Request a Quote",
      "text-12": "CUSTOM DEVELOPMENT",
      "text-13": "From concept to production",
      "text-14": "Project input",
      "text-15": "Start with your drawing, sample or a clear product requirement.",
      "text-16": "Material direction",
      "text-17": "Material selection can be evaluated around intended use, feel, construction and surface requirements.",
      "text-18": "Production support",
      "text-19": "Printing, cutting, RF welding, assembly and packaging can be coordinated for a custom project.",
      "text-20": "CUSTOM FORMATS",
      "text-21": "Developed to your requirements",
      "text-22": "These formats are starting points for custom development. Material, construction and project fit are confirmed from your brief or reference sample.",
      "text-23": "Zipper pouches",
      "text-24": "Discuss pouch formats around your size, closure, material and printing requirements.",
      "text-25": "Storage bags",
      "text-26": "Review practical storage formats for your intended use and product requirements.",
      "text-27": "Packaging formats",
      "text-28": "Discuss custom pouch formats for product protection, presentation or retail packaging.",
      "text-29": "Share a drawing, reference sample or product idea to discuss a suitable manufacturing approach.",
      "text-30": "START A PROJECT",
      "text-31": "Have a pouch or bag idea?",
      "text-32": "Drawing or sample review",
      "text-33": "Material selection",
      "text-34": "Prototype development",
      "text-35": "Production & packaging",
      "text-36": "Start your custom project",
      "text-37": "SOCIAL RESPONSIBILITY",
      "text-38": "BSCI social audit",
      "text-39": "Our factory has undergone an amfori BSCI social audit. Audit documentation is available to qualified buyers on request.",
      "meta_title": "Custom Bags & Pouches | LongDe Yizhi",
      "meta_desc": "Discuss custom zipper pouches, storage bags and packaging formats with LongDe Yizhi for your next B2B product project."
